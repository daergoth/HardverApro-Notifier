<div id="header" style="background-color:#2c2d37;">
	<div class="block-grid mixed-two-up"
		style="Margin: 0 auto; min-width: 320px; max-width: {{#if containerMaxWidth}}{{containerMaxWidth}}{{else}}500px{{/if}}; overflow-wrap: break-word; word-wrap: break-word; word-break: break-word; background-color: transparent;">
		<div style="border-collapse: collapse;display: table;width: 100%;background-color:transparent;">
			<div class="col num12" style="min-width: 320px; max-width: {{#if containerMaxWidth}}{{containerMaxWidth}}{{else}}500px{{/if}}; display: table-cell; vertical-align: top; width: {{#if containerMaxWidth}}{{containerMaxWidth}}{{else}}500px{{/if}};">
				<div style="width:100% !important;">
					<div style="padding-top:10px; padding-bottom:10px; padding-right: 12px; padding-left: 12px; text-align: center;">
						<div style="display: inline-block; vertical-align: middle;">
							<span style="display:inline-block; vertical-align: middle; padding-right: 10px;">
								<img alt="Logo" border="0" src="https://hardverapro.hu/design/logo-favicon.png" width="36" height="36" style="display:block; border:0; width:36px; height:36px;" />
							</span>
							<span style="display:inline-block; vertical-align: middle; font-family:Arial, Helvetica Neue, Helvetica, sans-serif; font-size: 22px; line-height: 1.2; color: #ffffff; font-weight: 700; white-space: nowrap;">HardverApró Notifier</span>
						</div>
						{{#if navHref}}
						<div style="padding-top:6px; text-align:center;">
							<a href="{{navHref}}" style="font-family:Arial, Helvetica Neue, Helvetica, sans-serif; font-size: 12px; line-height: 1.2; color: #ffffff; text-decoration: underline;">{{navText}}</a>
						</div>
						{{/if}}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
