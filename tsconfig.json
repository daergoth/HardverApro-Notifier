{
  "compileOnSave": true,
  "compilerOptions": {
    "module": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "target": "es6",
    "moduleResolution": "node16",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "lib": [
    "es2015"
  ],
  "include": [
    "src/**/*"
  ]
}